{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun --external zod-to-json-schema --external @prisma/client",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "authz:grant-admin": "bun run src/authz/grant-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "^7.10.1",
    "casbin": "^5.51.1",
    "casbin-prisma-adapter": "^1.12.0",
    "hono": "^4.13.21",
    "hono-openapi": "^1.6.0",
    "jose": "^6.2.18",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv": "^18.0.10",
    "prisma": "^7.0.0"
  }
}
